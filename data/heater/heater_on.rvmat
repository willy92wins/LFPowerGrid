// LF_PowerGrid - Heater elements material (ON / heating)
// heater.rvmat plus emission: same Super shader and stages, a red-hot orange
// emmisive[] and a Stage8 emissive map, as in the vanilla sea_chest / sea_chest_e pair.
// Applied to the "light_coils" selection while powered and switched on.
ambient[]={1,1,1,1};
diffuse[]={1,1,1,1};
forcedDiffuse[]={0,0,0,0};
emmisive[]={50,16,3,1};
specular[]={0.5,0.5,0.5,1};
specularPower=180;
PixelShaderID="Super";
VertexShaderID="Super";
class Stage1
{
	texture="\LFPowerGrid\data\heater\heater_nohq.paa";
	uvSource="tex";
	class uvTransform
	{
		aside[]={1,0,0};
		up[]={0,1,0};
		dir[]={0,0,1};
		pos[]={0,0,0};
	};
};
