+		for (row = 0; row <= gridH - itemH; row = row + 1)
+		{
+			for (col = 0; col <= gridW - itemW; col = col + 1)
+			{
+				fits = true;
+				for (dr = 0; dr < itemH; dr = dr + 1)
+				{
+					for (dc = 0; dc < itemW; dc = dc + 1)
+					{
+						if (checksRemaining <= 0)
+							return false;
