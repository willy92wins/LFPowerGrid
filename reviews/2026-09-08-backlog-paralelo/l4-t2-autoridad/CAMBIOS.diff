+		int vanillaCount = manager.GetVanillaWireOwnerCount();
+		for (int vanillaIndex = 0; vanillaIndex < vanillaCount; vanillaIndex = vanillaIndex + 1)
+		{
+			string vanillaId = manager.GetVanillaWireOwnerKey(vanillaIndex);
+			EntityAI vanillaObj = registry.FindById(vanillaId);
+			if (!vanillaObj)
