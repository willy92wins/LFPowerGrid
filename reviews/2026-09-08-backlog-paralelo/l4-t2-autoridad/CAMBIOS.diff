+			return false;
+		for (int deviceIndex = 0; deviceIndex < devices.Count(); deviceIndex = deviceIndex + 1)
+		{
+			EntityAI device = devices[deviceIndex];
+			if (!device || !LFPG_DeviceAPI.HasWireStore(device))
+				continue;
+			string deviceId = LFPG_DeviceAPI.GetDeviceId(device);
+			if (deviceId == "")
