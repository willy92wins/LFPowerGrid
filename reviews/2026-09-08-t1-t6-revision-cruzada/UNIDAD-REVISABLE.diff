+    protected static bool ParseNonNegativeIntText(string text, out int value)
+    {
+        value = 0;
+        if (text == "")
+            return false;
+        int i = 0;
+        int n = text.Length();
+        string ch = "";
+        bool isDigit = false;
+        for (i = 0; i < n; i = i + 1)
+        {
+            ch = text.Get(i);
+            isDigit = false;
+            if (ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4")
+                isDigit = true;
+            if (ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9")
+                isDigit = true;
+            if (!isDigit)
+                return false;
+        }
+        value = text.ToInt();
+        if (value < 0)
+            return false;
+        return true;
+    }
