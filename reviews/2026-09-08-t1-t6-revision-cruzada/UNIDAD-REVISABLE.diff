+        string allowed = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-";
+        int i = 0;
+        int n = uid.Length();
+        string ch = "";
+        for (i = 0; i < n; i = i + 1)
