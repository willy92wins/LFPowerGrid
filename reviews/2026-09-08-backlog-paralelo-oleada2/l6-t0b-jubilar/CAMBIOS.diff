-            perfPreview = perfPreview + " preview_send=";
-            perfPreview = perfPreview + m_PerfDiagPreviewSentCount.ToString();
-            perfPreview = perfPreview + " jsonLen=";
-            perfPreview = perfPreview + previewJSON.Length().ToString();
-            Print(perfPreview);
