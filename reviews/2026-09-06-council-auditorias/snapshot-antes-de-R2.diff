+    {
+        array<ref LFPG_BTCCurrency> currencies = LFPG_BTCConfig.GetCurrencies();
+        if (!currencies)
+            return;
+        int ci = 0;
+        for (ci = 0; ci < currencies.Count(); ci = ci + 1)
+        {
+            LFPG_BTCCurrency cur = currencies[ci];
+            if (!cur || cur.classname == "")
+                continue;
+            ProbeAndCacheStack(player, cur.classname);
+        }
