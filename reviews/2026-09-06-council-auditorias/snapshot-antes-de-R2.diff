+        if (!probe)
+            probe = SpawnOnGroundNear(classname, player.GetPosition());
+        if (!probe)
+        {
+            s_StackCapacityCache.Set(classname, 1);
+            return;
+        }
+
+        int maxStack = (int)probe.GetQuantityMax();
