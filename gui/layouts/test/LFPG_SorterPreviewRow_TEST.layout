// =========================================================
// S2 - Sorter V4 TEST preview row prefab -- replaces LFPG_SorterPreviewRow_TEST.layout
// One match row rendered inside GridSpacerWidget "PreviewItems" (264 px width).
// Same structure as the current prefab, re-anchored widths and numbered fonts.
// =========================================================
FrameWidgetClass PreviewRowRoot {
	size 1 30
	hexactpos 0
	vexactpos 0
	hexactsize 0
	vexactsize 1
	{
		ImageWidgetClass RowSep {
			position 0 29
			size 1 1
			hexactpos 0
			vexactpos 1
			hexactsize 0
			vexactsize 1
			stretch 1
			ignorepointer 1
			color 0.296 0.344 0.420 1
			{
			}
		}
		ImageWidgetClass CatBadge {
			position 10 4
			size 22 22
			hexactpos 1
			vexactpos 1
			hexactsize 1
			vexactsize 1
			stretch 1
			ignorepointer 1
			color 0.135 0.300 0.324 1
			{
			}
		}
		TextWidgetClass CatIcon {
			scriptclass "ViewBinding"
			position 10 4
			size 22 22
			hexactpos 1
			vexactpos 1
			hexactsize 1
			vexactsize 1
			font "gui/fonts/Metron12"
			"text halign" center
			"text valign" center
			ignorepointer 1
			{
				ScriptParamsClass S2Binding {
					Binding_Name "CatIcon"
					{
					}
				}
			}
		}
		TextWidgetClass ItemName {
			scriptclass "ViewBinding"
			position 40 0
			size 162 30
			hexactpos 1
			vexactpos 1
			hexactsize 1
			vexactsize 1
			font "gui/fonts/MetronBook14"
			"text valign" center
			ignorepointer 1
			{
				ScriptParamsClass S2Binding {
					Binding_Name "ItemName"
					{
					}
				}
			}
		}
		ImageWidgetClass SlotBadgeBg {
			position 208 6
			size 48 18
			hexactpos 1
			vexactpos 1
			hexactsize 1
			vexactsize 1
			stretch 1
			ignorepointer 1
			color 0.216 0.294 0.435 1
			{
			}
		}
		TextWidgetClass SlotText {
			scriptclass "ViewBinding"
			position 208 6
			size 48 18
			hexactpos 1
			vexactpos 1
			hexactsize 1
			vexactsize 1
			font "gui/fonts/Metron12"
			"text halign" center
			"text valign" center
			ignorepointer 1
			{
				ScriptParamsClass S2Binding {
					Binding_Name "SlotText"
					{
					}
				}
			}
		}
	}
}
